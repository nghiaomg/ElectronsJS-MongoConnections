{
  "name": "memory-mongo-connections",
  "version": "2.1.0",
  "description": "AskMongo - A MongoDB client with AI assistance for query generation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron --js-flags=\"--expose-gc\" .",
    "build": "electron-builder build --win --publish never",
    "build:mac": "electron-builder build --mac --publish never",
    "build:linux": "electron-builder build --linux --publish never",
    "build:all": "electron-builder build --win --linux --publish never",
    "deploy": "electron-builder build --win --publish always"
  },
  "author": "nghiaomg",
  "license": "ISC",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.0.2",
    "electron-builder": "^25.0.5"
  },
  "dependencies": {
    "@google/genai": "^0.13.0",
    "electron-store": "^10.0.1",
    "mongodb": "^6.8.0",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7"
  },
  "build": {
    "appId": "com.MemoryPlatform.AskMongo",
    "productName": "AskMongo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "logo.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "logo.ico",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "logo.ico",
      "target": ["AppImage", "deb"]
    }
  }
}
